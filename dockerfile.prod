# Imagen de producción de payments-ms. Es la más simple de las cinco: npm, sin
# Prisma y sin dependencias nativas, así que son tres etapas y nada más.

# ---------- deps ----------
FROM node:22-alpine AS deps

WORKDIR /usr/src/app

COPY package*.json ./

RUN npm ci

# ---------- build ----------
FROM node:22-alpine AS build

WORKDIR /usr/src/app

COPY --from=deps /usr/src/app/node_modules ./node_modules
COPY . .

RUN npm run build

# ---------- prod-deps ----------
FROM node:22-alpine AS prod-deps

WORKDIR /usr/src/app

COPY package*.json ./

RUN npm ci --omit=dev

# ---------- final ----------
FROM node:22-alpine

WORKDIR /usr/src/app

ENV NODE_ENV=production

COPY --from=prod-deps /usr/src/app/node_modules ./node_modules
COPY --from=build /usr/src/app/dist ./dist
COPY package.json ./

# Único servicio híbrido: expone HTTP de verdad (webhook de Stripe + checkout).
EXPOSE 3003

CMD ["node", "dist/main.js"]
