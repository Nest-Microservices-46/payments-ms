# Solo para correr el servicio a mano fuera de Docker.
#   cp .env.template .env
#
# payments-ms es el unico hibrido: escucha HTTP de verdad (webhook + checkout) y
# ademas habla NATS.

PORT=3003

NATS_SERVERS=nats://localhost:4222

# Todas required() en el schema de Joi: si falta una, el contenedor compila, arranca
# y sale de inmediato. Apuntan al fake-stripe que vive dentro de este mismo servicio.
STRIPE_API_URL=http://localhost:3003/v1
STRIPE_WEBHOOK_URL=http://localhost:3003/payments/webhook
STRIPE_WEBHOOK_SECRET=whsec_fake_local_secret
STRIPE_SUCCESS_URL=http://localhost:3003/payments/success
STRIPE_CANCEL_URL=http://localhost:3003/payments/cancel
